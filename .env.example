# Copy to .env.local for development.
#
# Only SESSION_SECRET is worth setting for a first deployment. Everything below
# is commented out on purpose: an importer that reads this file (Vercel does)
# offers every uncommented key as a required field, and a blank required field
# blocks the deploy.

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------- branding --
# Every product string the UI renders. Change these to rebrand the deployment.
# NEXT_PUBLIC_BRAND_NAME=Speech Evaluation Studio
# NEXT_PUBLIC_BRAND_SHORT_NAME=SES
# NEXT_PUBLIC_BRAND_TAGLINE=Speech Research Infrastructure
# NEXT_PUBLIC_BRAND_ORG=Spring Lab
# NEXT_PUBLIC_BRAND_DOCS_URL=/docs

# ---------------------------------------------------------- submissions ----
# With no connection string the app writes a JSON file: .data/ locally, and the
# OS temp directory on a serverless host, where it does NOT survive. Attach
# Postgres before collecting data you care about.
#
# Must be a plain postgres:// URL — node-postgres cannot dial the
# prisma+postgres:// Accelerate endpoint, and the app ignores it if given one.
# DATABASE_URL=postgresql://ses:ses@localhost:5432/ses

# Overrides the JSON store location.
# DATA_FILE=

# Protects /admin and the exports. Leave unset to keep that page open.
# ADMIN_PASSCODE=

# ---------------------------------------------- prototype bundle (legacy) --
# Path to the extracted portable listening bundle. Only needed before
# `npm run sync:bundle` has vendored it into data/ and public/audio/.
# Ignored unless the directory actually holds listening_samples.json.
# BUNDLE_DIR=

# Set only if the WAVs are hosted somewhere else instead of public/audio/.
# NEXT_PUBLIC_AUDIO_BASE_URL=

# ------------------------------------------------- later phases (unused) --
# Not read by any code yet — the queue, object storage and Auth.js land in
# phases 3 and 5. Left here as documentation, deliberately commented.
# REDIS_URL=redis://localhost:6379
# AUTH_SECRET=
# AUDIO_STORAGE_MODE=local
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=speech-evaluation
# FFMPEG_PATH=
# FFPROBE_PATH=

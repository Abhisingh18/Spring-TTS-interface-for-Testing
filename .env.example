# ---------------------------------------------------------------- branding --
# Every product string the UI renders. Change these to rebrand the deployment.
# NEXT_PUBLIC_BRAND_NAME=Speech Evaluation Studio
# NEXT_PUBLIC_BRAND_SHORT_NAME=SES
# NEXT_PUBLIC_BRAND_TAGLINE=Speech Research Infrastructure
# NEXT_PUBLIC_BRAND_ORG=Spring Lab
# NEXT_PUBLIC_BRAND_DOCS_URL=/docs

# ---------------------------------------------------------------- database --
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://ses:ses@localhost:5432/ses

# ------------------------------------------------------------------- queue --
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------- storage --
# AUDIO_STORAGE_MODE: "local" writes under .storage/, "minio" uses the S3 API.
AUDIO_STORAGE_MODE=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=speech-evaluation

# -------------------------------------------------------------------- auth --
# Long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=
SESSION_SECRET=
# Protects /admin and the exports while the full RBAC layer lands.
# ADMIN_PASSCODE=

# ------------------------------------------------------------------- audio --
# ffmpeg/ffprobe must be on PATH, or point at them explicitly.
# FFMPEG_PATH=
# FFPROBE_PATH=

# ---------------------------------------------- prototype bundle (legacy) --
# The original portable listening bundle. Only needed until `npm run sync:bundle`
# has vendored it, or until the bundle has been imported into the database.
BUNDLE_DIR=F:\spring tts\portable_listening_bundle_16khz

# Set only if the WAVs are hosted somewhere else instead of public/audio/.
# NEXT_PUBLIC_AUDIO_BASE_URL=https://cdn.example.com

# Local JSON submission store, used when DATABASE_URL is absent.
# DATA_FILE=F:\spring tts\listening-sessions.json
